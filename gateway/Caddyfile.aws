# The EDGE of the AWS deployment (docker-compose.aws.yml): the ONLY thing reachable from the internet. It puts
#   * HTTPS in front of both portals (a certificate from Caddy's own local authority: the browser warns once until you trust it or a real
#     domain + certificate replaces it), and
#   * a PASSWORD in front of both portals (HTTP basic authentication, checked here before any request reaches a portal; the portals keep their own sign-in).
# 443 -> the Super Admin portal, 3001 -> the Organization portal. Every backend service stays on the private Docker network.
{
	skip_install_trust
	default_sni {$PUBLIC_HOST}
	auto_https disable_redirects
	servers {
		# only TCP is published, so do not advertise HTTP/3 (UDP)
		protocols h1 h2
	}
}

(front_door) {
	tls internal

	# Nobody gets past this without the password; a wrong guess is slowed by the hash itself.
	basic_auth {
		{$EDGE_USER} {$EDGE_PASSWORD_HASH}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

https://{$PUBLIC_HOST} {
	import front_door
	reverse_proxy super-admin:3000 {
		header_up -Authorization # the front-door password is never passed on to a portal
	}
}

https://{$PUBLIC_HOST}:3001 {
	import front_door
	reverse_proxy dashboard:3001 {
		header_up -Authorization
	}
}
