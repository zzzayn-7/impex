# The EDGE of the AWS deployment (docker-compose.aws.yml): the ONLY thing reachable from the internet. It puts
#   * real HTTPS in front of everything: Caddy gets and renews free Let's Encrypt certificates for the domain by itself, and
#   * a PASSWORD in front of everything (HTTP basic authentication, checked here before any request reaches a portal; the portals keep their own sign-in).
#   admin.<domain>  the Super Admin portal         app.<domain>  the Organization portal         mail.<domain>  Mailpit (the platform's caught e-mail)
#   <domain>, www.<domain>  send people to app.<domain>
# Every backend service stays on the private Docker network. The certificates need ports 80 and 443 open and the domain's DNS pointing at this server.
{
	servers {
		# only TCP is published, so do not advertise HTTP/3 (UDP)
		protocols h1 h2
	}
}

(front_door) {
	# Nobody gets past this without the password; a wrong guess is slowed by the hash itself.
	basic_auth {
		{$EDGE_USER} {$EDGE_PASSWORD_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

admin.{$DOMAIN} {
	import front_door
	reverse_proxy super-admin:3000 {
		header_up -Authorization # the front-door password is never passed on to a portal
	}
}

app.{$DOMAIN} {
	import front_door
	reverse_proxy dashboard:3001 {
		header_up -Authorization
	}
}

mail.{$DOMAIN} {
	import front_door
	reverse_proxy mailpit:8025 {
		header_up -Authorization
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	redir https://app.{$DOMAIN}{uri} permanent
}
