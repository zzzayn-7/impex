{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "frontend/dashboard",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" },
        { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" },
        { "type": "service", "service": "sales-service", "format": "url", "env": "SALES_SERVICE_URL" },
        { "type": "service", "service": "purchasing-service", "format": "url", "env": "PURCHASING_SERVICE_URL" },
        { "type": "service", "service": "support-service", "format": "url", "env": "SUPPORT_SERVICE_URL" },
        { "type": "service", "service": "finance-service", "format": "url", "env": "FINANCE_SERVICE_URL" }
      ]
    },
    "super-admin": {
      "root": "frontend/super-admin",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" },
        { "type": "service", "service": "support-service", "format": "url", "env": "SUPPORT_SERVICE_URL" }
      ]
    },
    "auth-service": {
      "root": "services/auth-service",
      "framework": "fastapi"
    },
    "organization-service": {
      "root": "services/organization-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "purchasing-service", "format": "url", "env": "PURCHASING_SERVICE_URL" },
        { "type": "service", "service": "sales-service", "format": "url", "env": "SALES_SERVICE_URL" }
      ]
    },
    "inventory-service": {
      "root": "services/inventory-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" }
      ]
    },
    "sales-service": {
      "root": "services/sales-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" },
        { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" }
      ]
    },
    "purchasing-service": {
      "root": "services/purchasing-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" },
        { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" }
      ]
    },
    "support-service": {
      "root": "services/support-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" }
      ]
    },
    "finance-service": {
      "root": "services/finance-service",
      "framework": "fastapi",
      "bindings": [
        { "type": "service", "service": "auth-service", "format": "url", "env": "AUTH_SERVICE_URL" },
        { "type": "service", "service": "organization-service", "format": "url", "env": "ORG_SERVICE_URL" },
        { "type": "service", "service": "sales-service", "format": "url", "env": "SALES_SERVICE_URL" },
        { "type": "service", "service": "purchasing-service", "format": "url", "env": "PURCHASING_SERVICE_URL" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "admin." } }],
      "destination": { "service": "super-admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "dashboard" }
    }
  ],
  "schedules": {
    "finance-sync": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/finance-sync",
      "requestMethod": "POST"
    },
    "support-outbox": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/support-outbox",
      "requestMethod": "POST"
    }
  }
}
