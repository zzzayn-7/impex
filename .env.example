# -------------------------------------------------------------
# Global / Gateway Settings
# -------------------------------------------------------------
GATEWAY_PORT=80
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost

# -------------------------------------------------------------
# Auth Service Settings
# -------------------------------------------------------------
AUTH_PORT=8000
AUTH_SECRET_KEY=change_this_to_a_secure_random_key_in_production
# Connects to the "postgres" service using POSTGRES_USER / POSTGRES_PASSWORD below
AUTH_DB_NAME=impex_auth
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -------------------------------------------------------------
# Organization Service Settings
# -------------------------------------------------------------
ORG_PORT=8001
# Connects to the "postgres" service using POSTGRES_USER / POSTGRES_PASSWORD below
ORG_DB_NAME=impex_organizations

# -------------------------------------------------------------
# Frontend Settings
# -------------------------------------------------------------
SUPER_ADMIN_PORT=3000


# -------------------------------------------------------------
# PostgreSQL Settings
# (databases impex_auth and impex_organizations are created on first start
#  by database/init/01-create-databases.sql)
# -------------------------------------------------------------
POSTGRES_USER=impex_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_PORT=5433

# -------------------------------------------------------------
# Email / Invitations (SMTP)
#
# Default (local development): the "mailpit" container catches every email.
#   Inbox: http://localhost:8025   - nothing is sent to the internet.
#
# Real email via Gmail (for local testing): replace the SMTP_* values below with
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_SSL=false
#   SMTP_USERNAME=your.address@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop      <- a Google "App Password" (16 letters, no spaces),
#                                          NOT your normal Google password
#   SMTP_FROM_ADDRESS=your.address@gmail.com
#   SMTP_FROM_NAME=Impex
# Create the App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on for the Google account).
#
# Other providers: use their SMTP host/port; port 587 -> SMTP_STARTTLS=true,
# port 465 -> SMTP_SSL=true. Keep real credentials ONLY in .env (it is git-ignored).
#
# APP_BASE_URL is the address used in the activation link inside the email.
# -------------------------------------------------------------
APP_BASE_URL=http://localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM_ADDRESS=no-reply@impex.local
SMTP_FROM_NAME=Impex
MAILPIT_UI_PORT=8025
