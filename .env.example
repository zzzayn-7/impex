# -------------------------------------------------------------
# Global / Gateway Settings
# -------------------------------------------------------------
GATEWAY_PORT=80
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost

# -------------------------------------------------------------
# Auth Service Settings
# -------------------------------------------------------------
AUTH_PORT=8000
AUTH_SECRET_KEY=change_this_to_a_secure_random_key_in_production
# Connects to the "postgres" service using POSTGRES_USER / POSTGRES_PASSWORD below
AUTH_DB_NAME=impex_auth
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -------------------------------------------------------------
# Organization Service Settings
# -------------------------------------------------------------
ORG_PORT=8001
# Connects to the "postgres" service using POSTGRES_USER / POSTGRES_PASSWORD below
ORG_DB_NAME=impex_organizations

# -------------------------------------------------------------
# Frontend Settings
# -------------------------------------------------------------
SUPER_ADMIN_PORT=3000


# -------------------------------------------------------------
# PostgreSQL Settings
# (databases impex_auth and impex_organizations are created on first start
#  by database/init/01-create-databases.sql)
# -------------------------------------------------------------
POSTGRES_USER=impex_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_PORT=5433

# -------------------------------------------------------------
# Email / Invitations (SMTP)
#
# Real email is sent through the SMTP server below (Gmail by default in this template).
# Optional local mail catcher instead of real email: run
#   docker compose --profile mailpit up -d mailpit
# and set SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false, empty username/password
# (inbox: http://localhost:8025; nothing is sent to the internet).
#
# Gmail settings (these are the values used below):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_SSL=false
#   SMTP_USERNAME=your.address@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop      <- a Google "App Password" (16 letters, no spaces),
#                                          NOT your normal Google password
#   SMTP_FROM_ADDRESS=your.address@gmail.com
#   SMTP_FROM_NAME=Impex
# Create the App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on for the Google account).
#
# Other providers: use their SMTP host/port; port 587 -> SMTP_STARTTLS=true,
# port 465 -> SMTP_SSL=true. Keep real credentials ONLY in .env (it is git-ignored).
#
# APP_BASE_URL is the address used in the activation link inside the email.
# -------------------------------------------------------------
APP_BASE_URL=http://localhost
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Impex
MAILPIT_UI_PORT=8025

# -------------------------------------------------------------
# Service-to-service keys (internal APIs used for invitation activation)
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   AUTH_INTERNAL_API_KEY : organization-service -> auth-service  (create organization admin accounts)
#   ORG_ACTIVATION_API_KEY: super-admin frontend  -> organization-service (validate / accept invitations)
# Never exposed to browsers. Use different random values in every environment.
# -------------------------------------------------------------
AUTH_INTERNAL_API_KEY=change_this_to_a_long_random_value
ORG_ACTIVATION_API_KEY=change_this_to_a_different_long_random_value

# -------------------------------------------------------------
# Organization portal (frontend/dashboard)
# TENANT_PORTAL_URL is where organization administrators sign in; the Super Admin portal links to it
# after a successful invitation activation. Use the public https address in production.
# -------------------------------------------------------------
DASHBOARD_PORT=3001
TENANT_PORTAL_URL=http://localhost:3001

# -------------------------------------------------------------
# DEMO MODE  (for demonstrations ONLY - never enable on a real deployment)
# When true, "Add Administrator" creates the account immediately with the password below and emails
# the sign-in details (email + password) instead of an activation link. The Auth Service accepts the
# simple password only while this is true. Leave false for the secure invitation/activation flow.
# -------------------------------------------------------------
DEMO_MODE=false
DEMO_ADMIN_PASSWORD=12345678

# -------------------------------------------------------------
# Inventory Service (product catalog)
# Own database. On an EXISTING Postgres volume create it once with database/add-inventory-database.sql
# (fresh installs get it automatically), then run the migration:
#   docker compose run --rm --no-deps inventory-service alembic upgrade head
# -------------------------------------------------------------
INVENTORY_DB_NAME=impex_inventory
